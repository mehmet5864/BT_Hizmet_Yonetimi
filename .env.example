# Docker Compose bu dosyayi okur: degerleri tirnaksiz yazin.
# install-docker.bat / install-docker.sh eksik anahtarlari otomatik uretir (var olanlara dokunmaz).
# Oturum cerezini imzalar. Uretimde zorunlu.
SESSION_SECRET=degistirin
# PostgreSQL parolasi (ilk kurulumda belirlenir; sonradan degistirmeyin veya veritabaninda da degistirin).
POSTGRES_PASSWORD=degistirin
# HTTPS arkasinda true yapin. Yerel http://127.0.0.1 icin false.
SESSION_SECURE=false
# E-posta onay baglantilarinin tabani.
APP_URL=http://127.0.0.1:43130
# SEED_ON_START=true
# SEED_DEMO_EXTRA=false
# DB_POOL_MAX=20
# API_CORS_ORIGINS=https://entegrasyon.kurum.gov.tr
